# Copy to .env to override defaults. The app runs fine with no .env at all.
# SECRET_KEY=generate-a-real-one-for-anything-beyond-a-laptop
# DEBUG=True
# ALLOWED_HOSTS=localhost,127.0.0.1
# Where uploaded product and order images are written (default: ./media).
# MEDIA_ROOT=/var/lib/thoughttronix/media
# Let Django serve /media/ itself; set False only if a web server serves MEDIA_ROOT.
# SERVE_MEDIA=True
# Send the session and CSRF cookies over HTTPS only. Turn both on behind HTTPS.
# SESSION_COOKIE_SECURE=False
# CSRF_COOKIE_SECURE=False
# How long a sign-in lasts, in seconds (default: two weeks).
# SESSION_COOKIE_AGE=1209600
